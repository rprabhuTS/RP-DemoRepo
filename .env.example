# Transmit Security Configuration
# Get these from https://portal.transmitsecurity.io/ -> Your Application Settings

# Your Transmit Security Client ID (from your application in the Admin Portal)
TS_CLIENT_ID=your_client_id_here

# Your Transmit Security Client Secret (from your application in the Admin Portal)
TS_CLIENT_SECRET=your_client_secret_here

# Your Transmit Security Tenant ID
TS_TENANT_ID=9x6egrq3wzjp4hbg5fh02

# Transmit Security API Base URL (use api.eu.transmitsecurity.io for EU)
TS_API_BASE=https://api.transmitsecurity.io

# Application Settings
PORT=3000
SESSION_SECRET=change-this-to-a-random-secret
APP_URL=http://localhost:3000
